---
import { LOCALES, useTranslations, type Lang } from '@/i18n'
import { VISITED_COUNTRIES } from '@/consts'
import Layout from '@/layouts/Base.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getCollection } from 'astro:content'

import ProjectList from '@/components/ProjectList.astro'
import Certifications from '@/components/Certifications.astro'
import Globe from '@/components/globe/Globe.astro'
import WorkList from '@/components/WorkList.astro'

const locale = Astro.currentLocale as Lang
const t = useTranslations(locale)

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({ params: { lang } }))

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .filter((post) => post.id.split('/')[1] === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4)

const projectsUrl = getRelativeLocaleUrl(locale, 'projects')
const travelUrl = getRelativeLocaleUrl(locale, 'travel')
---

<Layout>
  <section class="intro">
    <h1 class="title">
      {t({
        en: "I'm André Brandão, a full stack developer building platforms and NixOS systems.",
        pt: 'Sou André Brandão, desenvolvedor full stack construindo plataformas e sistemas NixOS.',
      })}
    </h1>
    <p class="lede">
      {t({
        en: 'Full Stack Developer at A3Data. I co-founded a company with a professor from PUC-MG and shipped systems that are still running in production. I own the whole stack, from Terraform to UI, and run a declarative NixOS homelab at home.',
        pt: 'Desenvolvedor Full Stack na A3Data. Cofundei uma empresa com um professor da PUC-MG e entreguei sistemas que continuam rodando em produção. Cuido de toda a stack, do Terraform à interface, e mantenho um homelab declarativo em NixOS em casa.',
      })}
    </p>
    <p class="intro-links meta">
      <a
        class="intro-icon"
        href="https://github.com/andre-brandao"
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z" />
        </svg>
      </a>
      <a class="link" href={`/${locale}/cv.pdf`} target="_blank" rel="noopener">
        CV
      </a>
      <a
        class="intro-icon"
        href="mailto:eu@andrebrandao.dev"
        aria-label={t({ en: 'Email', pt: 'E-mail' })}
        title={t({ en: 'Email', pt: 'E-mail' })}
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m4 7 8 6 8-6" />
        </svg>
      </a>
    </p>
  </section>

  <h2 class="label">{t({ en: 'work', pt: 'experiência' })}</h2>
  <WorkList {locale} />

  <h2 class="label">{t({ en: 'projects', pt: 'projetos' })}</h2>
  <div class="teaser">
    <ProjectList projects={projects} locale={locale} open />
  </div>
  <p class="more more--timeline meta">
    <a class="link" href={projectsUrl}>
      {t({ en: 'All projects', pt: 'Todos os projetos' })} →
    </a>
  </p>

  <h2 class="label">{t({ en: 'certifications', pt: 'certificações' })}</h2>
  <Certifications lang={locale} />

  <h2 class="label">{t({ en: 'places', pt: 'lugares' })}</h2>
  <Globe visited={VISITED_COUNTRIES} />
  <p class="more meta">
    {t({ en: 'Countries I have visited.', pt: 'Países que já visitei.' })}
    <a class="link" href={travelUrl}>
      {t({ en: 'Full map', pt: 'Mapa completo' })} →
    </a>
  </p>
</Layout>

<style>
  .intro-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.25rem;
  }
  .intro-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .intro-icon:hover {
    color: var(--fg);
    transform: translateY(-1px);
  }
  .more {
    margin-top: 0.9rem;
  }
  /* the truncated project timeline fades out into the "all projects" link */
  .teaser {
    position: relative;
  }
  .teaser::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 7rem;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
    /* above the rows, below the floating hover preview (z-index 5) */
    z-index: 2;
  }
  /* the link sits under the fading line on the right */
  .more--timeline {
    margin-top: 0.25rem;
    text-align: right;
  }
</style>
