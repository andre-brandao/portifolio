---
import { LOCALES, useTranslations, type Lang } from '@/i18n'
import { VISITED_COUNTRIES } from '@/consts'
import Layout from '@/layouts/Base.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getCollection } from 'astro:content'

import ProjectList from '@/components/ProjectList.astro'
import Certifications from '@/components/Certifications.astro'
import Globe from '@/components/globe/Globe.astro'

const locale = Astro.currentLocale as Lang
const t = useTranslations(locale)

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({ params: { lang } }))

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .filter((post) => post.id.split('/')[1] === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4)

const projectsUrl = getRelativeLocaleUrl(locale, 'projects')
const travelUrl = getRelativeLocaleUrl(locale, 'travel')
---

<Layout>
  <section class="intro">
    <h1 class="title">
      {t({
        en: "I'm André Brandão, a full stack developer building platforms and NixOS systems.",
        pt: 'Sou André Brandão, desenvolvedor full stack construindo plataformas e sistemas NixOS.',
      })}
    </h1>
    <p class="lede">
      {t({
        en: 'Full Stack Developer at A3Data. I co-founded a company with a professor from PUC-MG and shipped systems that are still running in production. I own the whole stack, from Terraform to UI, and run a declarative NixOS homelab at home.',
        pt: 'Desenvolvedor Full Stack na A3Data. Cofundei uma empresa com um professor da PUC-MG e entreguei sistemas que continuam rodando em produção. Cuido de toda a stack, do Terraform à interface, e mantenho um homelab declarativo em NixOS em casa.',
      })}
    </p>
    <p class="intro-links meta">
      <a
        class="link"
        href="https://github.com/andre-brandao"
        target="_blank"
        rel="noopener"
      >
        GitHub
      </a>
      <a class="link" href={`/${locale}/cv.pdf`} target="_blank" rel="noopener">
        CV
      </a>
      <a class="link" href="mailto:eu@andrebrandao.dev">
        eu@andrebrandao.dev
      </a>
    </p>
  </section>

  <h2 class="label">{t({ en: 'projects', pt: 'projetos' })}</h2>
  <div class="teaser">
    <ProjectList projects={projects} locale={locale} open />
  </div>
  <p class="more more--timeline meta">
    <a class="link" href={projectsUrl}>
      {t({ en: 'All projects', pt: 'Todos os projetos' })} →
    </a>
  </p>

  <h2 class="label">{t({ en: 'certifications', pt: 'certificações' })}</h2>
  <Certifications lang={locale} />

  <h2 class="label">{t({ en: 'places', pt: 'lugares' })}</h2>
  <Globe visited={VISITED_COUNTRIES} />
  <p class="more meta">
    {t({ en: 'Countries I have visited.', pt: 'Países que já visitei.' })}
    <a class="link" href={travelUrl}>
      {t({ en: 'Full map', pt: 'Mapa completo' })} →
    </a>
  </p>
</Layout>

<style>
  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .more {
    margin-top: 0.9rem;
  }
  /* the truncated project timeline fades out into the "all projects" link */
  .teaser {
    position: relative;
  }
  .teaser::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 7rem;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
    /* above the rows, below the floating hover preview (z-index 5) */
    z-index: 2;
  }
  /* the link sits under the fading line on the right */
  .more--timeline {
    margin-top: 0.25rem;
    text-align: right;
  }
</style>
