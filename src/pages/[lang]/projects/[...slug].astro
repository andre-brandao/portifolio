---
import Layout from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { useTranslations, type Lang } from "@/i18n";
import TagList from "@/components/TagList.astro";
import GitHub from "@/icons/github.svg";

export async function getStaticPaths() {
  const posts = await getCollection("projects", ({ data }) => !data.draft);
  return posts.map((post) => {
    const [slug, lang] = post.id.split("/");
    return { params: { lang, slug }, props: post };
  });
}

const { lang } = Astro.params;
const post = Astro.props;
const t = useTranslations(lang as Lang);
const { Content } = await render(post);

const title = post.data.title;
// Dates in frontmatter are UTC midnight; render them in UTC so the day
// does not slip in negative-offset timezones.
const date = post.data.date.toLocaleDateString(lang, {
  year: "numeric",
  month: "long",
  timeZone: "UTC",
});
---

<Layout {title} description={post.data.description}>
  <header class="post-head">
    <div>
      <h1 class="title" transition:name={title}>{title}</h1>
      <p class="meta post-meta">
        <time datetime={post.data.date.toISOString()}>{date}</time>
      </p>
      <div class="post-tags">
        <TagList tags={post.data.tags} locale={lang as string} />
      </div>
    </div>
    {
      post.data.github && (
        <a
          class="post-repo"
          href={post.data.github}
          target="_blank"
          rel="noopener"
          title={t({ en: "Source on GitHub", pt: "Código no GitHub" })}
          aria-label={t({ en: "Source on GitHub", pt: "Código no GitHub" })}
        >
          <GitHub width={18} height={18} aria-hidden="true" />
        </a>
      )
    }
  </header>

  {
    post.data.cover && (
      <Image
        src={post.data.cover}
        width={1216}
        format="webp"
        alt=""
        class="post-cover"
        transition:name={title + "image"}
      />
    )
  }

  <div class="prose">
    <Content />
  </div>
</Layout>

<style>
  .post-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .post-repo {
    flex-shrink: 0;
    display: inline-flex;
    padding: 0.4rem;
    margin-top: 0.1rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    color: var(--muted);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .post-repo:hover {
    color: var(--fg);
    border-color: var(--rule-strong);
  }
  .post-meta {
    margin-top: 0.6rem;
  }
  .post-tags {
    margin-top: 0.6rem;
  }
  .post-cover {
    margin-top: 2rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
  }
  .prose {
    margin-top: 2.5rem;
  }
</style>
