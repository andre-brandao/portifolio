---
import Layout from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { useTranslations, type Lang } from "@/i18n";

export async function getStaticPaths() {
  const posts = await getCollection("projects", ({ data }) => !data.draft);
  return posts.map((post) => {
    const [slug, lang] = post.id.split("/");
    return { params: { lang, slug }, props: post };
  });
}

const { lang } = Astro.params;
const post = Astro.props;
const t = useTranslations(lang as Lang);
const { Content } = await render(post);

const title = post.data.title;
// Dates in frontmatter are UTC midnight; render them in UTC so the day
// does not slip in negative-offset timezones.
const date = post.data.date.toLocaleDateString(lang, {
  year: "numeric",
  month: "long",
  timeZone: "UTC",
});
---

<Layout {title} description={post.data.description}>
  <header class="post-head">
    <div>
      <h1 class="title" transition:name={title}>{title}</h1>
      <p class="meta post-meta">
        <time datetime={post.data.date.toISOString()}>{date}</time>
        {post.data.tags.length > 0 && <span> · {post.data.tags.join(", ")}</span>}
      </p>
    </div>
    {
      post.data.github && (
        <a
          class="post-repo"
          href={post.data.github}
          target="_blank"
          rel="noopener"
          title={t({ en: "Source on GitHub", pt: "Código no GitHub" })}
          aria-label={t({ en: "Source on GitHub", pt: "Código no GitHub" })}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z" />
          </svg>
        </a>
      )
    }
  </header>

  {
    post.data.cover && (
      <Image
        src={post.data.cover}
        width={1216}
        format="webp"
        alt=""
        class="post-cover"
        transition:name={title + "image"}
      />
    )
  }

  <div class="prose">
    <Content />
  </div>
</Layout>

<style>
  .post-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .post-repo {
    flex-shrink: 0;
    display: inline-flex;
    padding: 0.4rem;
    margin-top: 0.1rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    color: var(--muted);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .post-repo:hover {
    color: var(--fg);
    border-color: var(--rule-strong);
  }
  .post-meta {
    margin-top: 0.6rem;
  }
  .post-cover {
    margin-top: 2rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
  }
  .prose {
    margin-top: 2.5rem;
  }
</style>
