---
import Layout from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("projects", ({ data }) => !data.draft);
  return posts.map((post) => {
    const [lang, ...slug] = post.id.split("/");
    return { params: { lang, slug: slug.join("/") || undefined }, props: post };
  });
}

const { lang } = Astro.params;
const post = Astro.props;
const { Content } = await render(post);

const title = post.data.title;
// Dates in frontmatter are UTC midnight; render them in UTC so the day
// does not slip in negative-offset timezones.
const date = post.data.date.toLocaleDateString(lang, {
  year: "numeric",
  month: "long",
  timeZone: "UTC",
});
---

<Layout {title} description={post.data.description}>
  <header class="post-head">
    <h1 class="title" transition:name={title}>{title}</h1>
    <p class="meta post-meta">
      <time datetime={post.data.date.toISOString()}>{date}</time>
      {post.data.tags.length > 0 && <span> · {post.data.tags.join(", ")}</span>}
    </p>
  </header>

  {
    post.data.cover && (
      <Image
        src={post.data.cover}
        width={1216}
        format="webp"
        alt=""
        class="post-cover"
        transition:name={title + "image"}
      />
    )
  }

  <div class="prose">
    <Content />
  </div>
</Layout>

<style>
  .post-meta {
    margin-top: 0.6rem;
  }
  .post-cover {
    margin-top: 2rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
  }
  .prose {
    margin-top: 2.5rem;
  }
</style>
