---
// Base layout for every page: head metadata, header, footer, one column.

import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import LocaleSuggest from '@/components/i18n/LocaleSuggest.astro'

import { ClientRouter } from 'astro:transitions'

import { SITE_TITLE, SITE_DESCRIPTION, X_ACCOUNT } from '@/consts'
import { useTranslations, LOCALES, getLocalePaths, type Lang } from '@/i18n'
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
  frontmatter?: undefined
}

const t = useTranslations(Astro.currentLocale as Lang)
const { title, description } = Astro.props.frontmatter || Astro.props

const locale = Astro.currentLocale as Lang
const localeTitle = title ? `${title} · ${t(SITE_TITLE)}` : t(SITE_TITLE)
const localeDescription = description || t(SITE_DESCRIPTION)

const fontHref =
  'https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap'
---

<html lang={LOCALES[locale].lang || locale} dir={LOCALES[locale].dir || null}>
  <head>
    <meta charset="UTF-8" />
    <title>{localeTitle}</title>
    <meta name="description" content={localeDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      href={`/${locale}/rss.xml`}
      title={localeTitle}
    />
    <meta name="generator" content={Astro.generator} />
    {getLocalePaths(Astro.url).map((props) => (
      <link
        rel="alternate"
        hreflang={LOCALES[props.lang].lang || props.lang}
        href={Astro.site?.origin + props.path}
      />
    ))}

    <!-- icon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="icon" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply a stored light/dark choice before anything paints (see ThemeToggle).
      const t = localStorage.theme;
      if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
    </script>
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fcfcfa"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#111110"
    />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={localeTitle} />
    <meta property="og:site_name" content={localeTitle} />
    <meta property="og:description" content={localeDescription} />
    <meta property="og:image" content={Astro.site + 'ogp.png'} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:locale" content={LOCALES[locale].lang || locale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content={t(X_ACCOUNT)} />

    <!-- Font: JetBrains Mono, loaded without blocking first paint -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontHref} />
    <link
      rel="stylesheet"
      href={fontHref}
      media="print"
      onload={`this.media='all'`}
    />
    <noscript>
      <link rel="stylesheet" href={fontHref} />
    </noscript>

    <!-- analytics -->
    <script
      is:inline
      src="https://a.developing.company/api/script.js"
      data-site-id="d62229ea7c1b"
      defer></script>

    <ClientRouter />
  </head>

  <body>
    <div class="site">
      <LocaleSuggest />
      <Header />
      <main class="wrap">
        <slot />
      </main>
      <Footer />
    </div>

    {import.meta.env.DEV && <style>
      :root {
        scroll-behavior: auto;
      }
    </style>}
  </body>
</html>
