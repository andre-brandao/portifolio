---
// Heading block for simple pages: title plus an optional intro in the slot.

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="page-head">
  <h1 class="title" transition:name={title}>{title}</h1>
  <slot />
</header>

<style>
  .page-head {
    margin-block-end: 2.5rem;
  }
  .page-head :global(p) {
    color: var(--muted);
    margin-top: 0.75rem;
    max-width: 34rem;
  }
</style>
