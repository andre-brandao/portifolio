---
import LocalesHomeList from "@/components/i18n/LocalesHomeList.astro";
import { useTranslations, type Lang } from "@/i18n";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="wrap footer meta" transition:name="footer">
  <div class="footer-row">
    <span>© {year} André Brandão</span>
    <nav class="footer-links" aria-label="Elsewhere">
      <a class="link" href="https://github.com/andre-brandao" target="_blank" rel="noopener">GitHub</a>
      <a class="link" href="https://www.linkedin.com/in/andr%C3%A9-brand%C3%A3o-719684239/" target="_blank" rel="noopener">LinkedIn</a>
      <a class="link" href="mailto:eu@andrebrandao.dev">{t({ en: "Email", pt: "Email" })}</a>
      <a class="link" href={`/${locale}/rss.xml`}>RSS</a>
    </nav>
  </div>
  <ul class="footer-langs">
    <LocalesHomeList />
  </ul>
</footer>

<style is:global>
  .footer {
    margin-top: auto;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  .footer-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .footer-links {
    display: flex;
    gap: 1rem;
  }
  .footer-langs {
    display: flex;
    gap: 1rem;
  }
  .footer-langs a {
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.2em;
  }
  .footer-langs a:hover {
    text-decoration-color: currentColor;
  }
</style>
