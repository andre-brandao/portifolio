---
// One project in a list: small square thumbnail, title, one-line description,
// and on the right an optional GitHub link followed by the year. The year has
// a fixed width and always sits flush right, on the timeline line drawn by
// ProjectList. The title link is stretched over the whole row, so the row stays
// clickable while the GitHub icon remains a separate, valid link. Tags render
// as a line of icons/badges under the description (see TagList).

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import TagList from "@/components/TagList.astro";
import GitHub from "@/icons/github.svg";

interface Props {
  title: string;
  desc: string;
  href: string;
  img?: ImageMetadata;
  year?: number | string;
  github?: string;
  tags?: string[];
  /** Locale used to build tag page links */
  locale?: string;
  /** URLs of larger images ProjectList cycles through while hovering */
  previews?: string[];
}

const { title, desc, href, img, year, github, tags = [], locale = "en", previews = [] } = Astro.props;
---

<li class="row" data-previews={previews.length ? JSON.stringify(previews) : undefined}>
  <span class:list={["row-thumb", !img && "row-thumb--empty"]}>
    {
      img && (
        <Image
          src={img}
          width={96}
          height={96}
          format="webp"
          alt=""
          transition:name={title + "image"}
        />
      )
    }
  </span>
  <span class="row-main">
    <a href={href} class="row-title" transition:name={title}>{title}</a>
    <span class="row-desc">{desc}</span>
    {
      tags.length > 0 && (
        <span class="row-tags">
          <TagList {tags} {locale} />
        </span>
      )
    }
  </span>
  <span class="row-aside meta">
    {
      github && (
        <a
          class="row-repo"
          href={github}
          target="_blank"
          rel="noopener"
          title="GitHub"
          aria-label={`${title} on GitHub`}
        >
          <GitHub width={14} height={14} aria-hidden="true" />
        </a>
      )
    }
    {year && <span class="row-year">{year}</span>}
  </span>
</li>

<style>
  .row-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .row-tags {
    margin-top: 0.4rem;
  }
  .row-aside {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .row-repo {
    position: relative;
    z-index: 1;
    display: inline-flex;
    color: var(--faint);
    transition: color 0.15s ease;
  }
  .row-repo:hover {
    color: var(--fg);
  }
</style>
