---
// Tells the reader the page only exists in some languages.

import { useTranslations, type Lang } from "@/i18n";
import { NOT_TRANSLATED_CAUTION } from "@/consts";

interface Props {
  usedLangs: Lang[];
}

const t = useTranslations(Astro.currentLocale as Lang);
const { usedLangs } = Astro.props;
const currentLocale = Astro.currentLocale as Lang;
---

{
  !usedLangs.includes(currentLocale) && (
    <p class="caution" role="note">
      {t(NOT_TRANSLATED_CAUTION)}
    </p>
  )
}

<style>
  .caution {
    margin-block: 0 2rem;
    padding: 0.6rem 0.9rem;
    font-size: 0.875rem;
    color: var(--muted);
    background: var(--bg-2);
    border-inline-start: 2px solid var(--rule-strong);
    border-radius: 0 4px 4px 0;
  }
  .caution::before {
    content: "! ";
    color: var(--faint);
  }
</style>
