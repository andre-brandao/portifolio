---
// Offers a link to the page in the visitor's browser language when it
// differs from the language being viewed. Hidden until the check runs.

import { LOCALES, type Lang } from "@/i18n";

const currentLocale = Astro.currentLocale as Lang;
const labels: Record<string, string> = {
  en: "Read this page in English",
  pt: "Ler esta página em Português",
};
---

<div class="suggest wrap" id="js-languageSuggest" hidden>
  <a id="js-link" href="#" class="link"></a>
  <button id="js-close" type="button" aria-label="Dismiss">×</button>
</div>

<script is:inline define:vars={{ currentLocale, LOCALES, labels }}>
  function initLanguageSuggest() {
    const browserLang = navigator.language.toLowerCase();
    const suggest = document.getElementById("js-languageSuggest");

    const showSuggest = (lang) => {
      const pathnames = location.pathname.split("/");
      const link = document.getElementById("js-link");

      pathnames[1] = lang;
      link.href = pathnames.join("/");
      link.textContent = labels[lang] || LOCALES[lang].label;
      suggest.hidden = false;
    };

    if (
      currentLocale === browserLang ||
      currentLocale === browserLang.split("-")[0] ||
      localStorage.languageSuggestDenied ||
      localStorage.selectedLang
    ) {
      return;
    } else if (Object.keys(LOCALES).includes(browserLang)) {
      showSuggest(browserLang);
    } else if (Object.keys(LOCALES).includes(browserLang.split("-")[0])) {
      showSuggest(browserLang.split("-")[0]);
    }

    document.getElementById("js-close").addEventListener("click", () => {
      suggest.hidden = true;
      localStorage.languageSuggestDenied = true;
    });
  }

  initLanguageSuggest();
</script>

<style>
  .suggest {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
    border-bottom: 1px solid var(--rule);
  }
  .suggest[hidden] {
    display: none;
  }
  button {
    color: var(--faint);
    font-size: 1.1rem;
    line-height: 1;
    padding: 0.25rem;
  }
  button:hover {
    color: var(--fg);
  }
</style>
