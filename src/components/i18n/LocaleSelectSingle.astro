---
// Link to the same page in the other language. Assumes exactly two locales.

import { LOCALES } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

const langs = Object.keys(LOCALES);
console.assert(langs.length === 2, "LocaleSelectSingle expects exactly 2 locales.");

const otherLang = Astro.currentLocale === langs[0] ? langs[1] : langs[0];
const href = getRelativeLocaleUrl(
  otherLang,
  Astro.url.pathname.replace(/^\/[a-zA-Z-]+/, ""),
);
---

<a
  {href}
  class="nav-link"
  hreflang={otherLang}
  lang={otherLang}
  onclick={`localStorage.selectedLang = "${otherLang}"`}
>
  {LOCALES[otherLang].label}
</a>
