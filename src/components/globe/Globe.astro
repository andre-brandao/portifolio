---
// Orthographic globe drawn with d3. Visited countries are filled with the
// text colour, everything else stays a hairline grey, so it reads in light
// and dark mode. d3 and the world data are only fetched when the globe
// scrolls into view.

interface Props {
  visited: readonly string[];
  maxDiameter?: number;
}

const { visited, maxDiameter = 420 } = Astro.props;
---

<div
  class="globe"
  data-globe
  data-visited={JSON.stringify(visited)}
  data-max-diameter={maxDiameter}
></div>

<script>
  type Feature = { properties: { name: string } };

  async function mount(el: HTMLElement) {
    const visited: string[] = JSON.parse(el.dataset.visited ?? "[]");
    const [d3, world] = await Promise.all([import("d3"), import("./world.json")]);
    const features = (world.default as { features: Feature[] }).features;

    el.replaceChildren();
    const width = el.clientWidth;
    const maxDiameter = Number(el.dataset.maxDiameter) || 420;
    const height = Math.min(width, maxDiameter);
    const radius = height / 2 - 1;

    const projection = d3
      .geoOrthographic()
      .scale(radius)
      .translate([width / 2, height / 2])
      .rotate([60, -15]);
    const path = d3.geoPath(projection);

    const svg = d3
      .select(el)
      .append("svg")
      .attr("viewBox", `0 0 ${width} ${height}`)
      .attr("width", width)
      .attr("height", height)
      .attr("role", "img")
      .attr("aria-label", "Globe highlighting visited countries");

    svg
      .append("circle")
      .attr("class", "globe-sphere")
      .attr("cx", width / 2)
      .attr("cy", height / 2)
      .attr("r", radius);

    const graticule = svg
      .append("path")
      .datum(d3.geoGraticule10())
      .attr("class", "globe-graticule")
      .attr("d", path);

    const countries = svg
      .append("g")
      .selectAll("path")
      .data(features)
      .join("path")
      .attr("class", (d) =>
        visited.includes(d.properties.name)
          ? "globe-country is-visited"
          : "globe-country",
      )
      .attr("d", path as never);

    const redraw = () => {
      countries.attr("d", path as never);
      graticule.attr("d", path as never);
    };

    let spinning = true;
    const timer = d3.timer(() => {
      if (!spinning) return;
      const [lambda, phi] = projection.rotate();
      projection.rotate([lambda + 0.12, phi]);
      redraw();
    });

    const drag = d3
      .drag<SVGSVGElement, unknown>()
      .on("start", () => {
        spinning = false;
      })
      .on("drag", (event) => {
        const [lambda, phi] = projection.rotate();
        const k = 60 / projection.scale();
        projection.rotate([
          lambda + event.dx * k,
          Math.max(-90, Math.min(90, phi - event.dy * k)),
        ]);
        redraw();
      })
      .on("end", () => {
        spinning = true;
      });
    svg.call(drag);

    document.addEventListener("astro:before-swap", () => timer.stop(), {
      once: true,
    });
  }

  function init() {
    const el = document.querySelector<HTMLElement>("[data-globe]");
    if (!el) return;
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          mount(el);
        }
      },
      { rootMargin: "200px" },
    );
    io.observe(el);
  }

  init();
  document.addEventListener("astro:after-swap", init);
</script>

<style is:global>
  .globe {
    width: 100%;
    min-height: 12rem;
    touch-action: pan-y;
    cursor: grab;
  }
  .globe:active {
    cursor: grabbing;
  }
  .globe svg {
    width: 100%;
    height: auto;
    margin-inline: auto;
  }
  .globe-sphere {
    fill: var(--bg-2);
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .globe-graticule {
    fill: none;
    stroke: var(--rule);
    stroke-width: 0.5;
  }
  .globe-country {
    fill: var(--rule-strong);
    stroke: var(--bg);
    stroke-width: 0.4;
  }
  .globe-country.is-visited {
    fill: var(--fg);
  }
</style>
