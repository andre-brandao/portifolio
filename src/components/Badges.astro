---
// Training badges as a grid of icons, each linking to its Credly page.

import { useTranslations, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

type Badge = {
  image: string;
  verifyUrl: string;
  label: { en: string; pt: string };
};

const badges: Badge[] = [
  {
    image: "/badges/aws-academy-graduate-cloud-foundations-training-bad.png",
    verifyUrl: "https://www.credly.com/badges/feacbf3b-5273-496c-a5d6-2fe24926a591",
    label: {
      en: "AWS Academy Graduate, Cloud Foundations",
      pt: "AWS Academy Graduate, Cloud Foundations",
    },
  },
  {
    image: "/badges/aws-partner-agentic-ai-essentials-training-badge.png",
    verifyUrl: "https://www.credly.com/badges/33a12707-44dd-46ad-a2db-9b4a9bf6b379",
    label: {
      en: "AWS Partner, Agentic AI Essentials",
      pt: "AWS Partner, Agentic AI Essentials",
    },
  },
  {
    image: "/badges/aws-partner-digital-sovereignty-on-aws-technical-tr.png",
    verifyUrl: "https://www.credly.com/badges/1c83d28d-b6bd-4f32-8221-dd43e1c0944a",
    label: {
      en: "AWS Partner, Digital Sovereignty on AWS (Technical)",
      pt: "AWS Partner, Soberania Digital na AWS (Técnico)",
    },
  },
  {
    image: "/badges/aws-partner-generative-ai-technical-training-badge.png",
    verifyUrl: "https://www.credly.com/badges/abee1148-2c35-4330-a089-576ab8b6ac63",
    label: {
      en: "AWS Partner, Generative AI Technical",
      pt: "AWS Partner, IA Generativa Técnica",
    },
  },
  {
    image: "/badges/aws-partner-technical-accredited-training-badge.png",
    verifyUrl: "https://www.credly.com/badges/b828e769-2871-42ce-9da9-ce5250c305b5",
    label: {
      en: "AWS Partner, Technical Accredited",
      pt: "AWS Partner, Técnico Certificado",
    },
  },
];
---

<ul class="badges">
  {
    badges.map((badge) => (
      <li>
        <a
          href={badge.verifyUrl}
          target="_blank"
          rel="noopener noreferrer"
          title={t(badge.label)}
          aria-label={t(badge.label)}
        >
          <img src={badge.image} alt="" loading="lazy" decoding="async" width="96" height="96" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .badges {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
    gap: 1rem;
  }
  .badges a {
    display: block;
    opacity: 0.85;
    transition: opacity 0.15s ease;
  }
  .badges a:hover,
  .badges a:focus-visible {
    opacity: 1;
  }
  .badges img {
    width: 100%;
    height: auto;
  }
</style>
