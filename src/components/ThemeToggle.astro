---
// Light/dark toggle. A choice is stored in localStorage and applied as
// data-theme on <html>; with no choice the site follows the system setting.

import Sun from "@/icons/sun.svg";
import Moon from "@/icons/moon.svg";
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
  <Sun class="icon-sun" width={15} height={15} aria-hidden="true" />
  <Moon class="icon-moon" width={15} height={15} aria-hidden="true" />
</button>

<script>
  type Theme = "light" | "dark";

  const stored = (): Theme | undefined => {
    const v = localStorage.theme;
    return v === "light" || v === "dark" ? v : undefined;
  };

  const apply = (doc: Document, theme: Theme | undefined) => {
    if (theme) doc.documentElement.dataset.theme = theme;
    else delete doc.documentElement.dataset.theme;
  };

  const effective = (): Theme =>
    (document.documentElement.dataset.theme as Theme | undefined) ??
    (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

  const bind = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const next: Theme = effective() === "dark" ? "light" : "dark";
        localStorage.theme = next;
        apply(document, next);
      });
    });
  };

  bind();
  // Keep the choice across view transitions without a flash: set it on the
  // incoming document before it is swapped in.
  document.addEventListener("astro:before-swap", (e) => apply(e.newDocument, stored()));
  document.addEventListener("astro:after-swap", bind);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem;
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .theme-toggle:hover {
    color: var(--fg);
  }
  .icon-moon {
    display: none;
  }
  /* Show the moon while light, the sun while dark */
  :global(:root[data-theme="dark"]) .icon-moon {
    display: block;
  }
  :global(:root[data-theme="dark"]) .icon-sun {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .icon-moon {
      display: block;
    }
    :global(:root:not([data-theme="light"])) .icon-sun {
      display: none;
    }
  }
</style>
