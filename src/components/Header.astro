---
import { Image } from "astro:assets";
import LocaleSwitch from "@/components/i18n/LocaleSelectSingle.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { type Lang } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale as Lang;
---

<header class="header">
  <div class="wrap header-inner">
    <a href={getRelativeLocaleUrl(locale, "/")} class="brand">
      <Image
        src="/profile.jpeg"
        width={56}
        height={56}
        format="webp"
        alt=""
        class="brand-photo"
      />
      <span>André Brandão</span>
    </a>

    <div class="nav">
      <LocaleSwitch />
      <ThemeToggle />
    </div>
  </div>
</header>

<style is:global>
  /* Pinned to the top on every page. The full-width bar keeps content
     scrolling beneath it hidden, while the rule matches the footer width. */
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 500;
  }
  .brand-photo {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--rule);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.9375rem;
  }
  .nav-link {
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .nav-link:hover,
  .nav-link.is-active {
    color: var(--fg);
  }
</style>
